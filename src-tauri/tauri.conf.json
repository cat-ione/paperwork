{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperwork",
  "version": "0.3.0",
  "identifier": "dev.catione.paperwork",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paperwork",
        "width": 1320,
        "height": 880,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ]
  }
}
